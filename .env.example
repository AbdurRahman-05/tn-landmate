# ===================================================
# TN LandMate - Environment Configuration Template
# ===================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
PROJECT_NAME="TN LandMate"
DEBUG=true

# API Server
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# Security & Authentication
# Generate with: openssl rand -hex 32
SECRET_KEY=change-this-to-a-super-secret-hex-key-in-production-1234567890
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
# For local dev without Docker, backend automatically falls back to SQLite if PG is unreachable
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tn_landmate
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tn_landmate
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tn_landmate

# Redis Cache & Rate Limiting (Optional)
REDIS_URL=redis://localhost:6379/0

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000","http://10.0.2.2:8000"]

# AI Assistant Configuration
# Optional: Set OpenAI or Gemini key. If empty, educational fallback mode is used safely.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Mobile App API Endpoint Reference
# For Android Emulator: http://10.0.2.2:8000/api/v1
# For iOS Simulator / Web: http://localhost:8000/api/v1
# For Physical Device on LAN: http://<YOUR_LAN_IP>:8000/api/v1
MOBILE_API_BASE_URL=http://localhost:8000/api/v1
